# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Logs and local environment
*.log
.env
.env.*

# Dependencies - the scripts use only the Node standard library (the curl binary
# is an external fallback transport, not a package), so this only guards against
# a stray install
node_modules/

# Run artifacts. The skill writes these to $BRIEFING_DIR (default ./briefings),
# never into this repository; ignored here only so an in-tree run stays clean.
briefing-state.json
.items.json
.markets.json
.feeds.json
.fetch-ledger.json
.staging/
briefing-*.md
briefing-*.html

# briefings/ is the output directory; ignore it.
briefings/
