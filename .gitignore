# OS cruft
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Logs and local environment
*.log
.env
.env.*

# Dependencies - these scripts use only the Node standard library,
# so this only guards against a stray install
node_modules/

# Run artifacts. The skill writes these to $BRIEFING_DIR (default ./briefings),
# never into this repository; ignored here only so an in-tree run stays clean.
briefing-state.json
.items.json
.markets.json
.feeds.json
briefing-*.md
briefing-*.html
